---
import Base from "../../../layouts/Base.astro";
import ListingCard from "../../../components/ListingCard.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { active, eur, median, SECTORES, type Listing } from "../../../lib/data";

// Página "traspasos <sector> <provincia>": las que más tráfico de Google atraen.
export function getStaticPaths() {
  const groups = new Map<string, Listing[]>();
  for (const l of active) {
    if (!l.provincia) continue;
    const k = `${l.sector}|${l.provincia}`;
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k)!.push(l);
  }
  return [...groups.entries()].map(([k, items]) => {
    const [sector, provincia] = k.split("|");
    return { params: { sector, provincia }, props: { sector, items } };
  });
}
const { sector, items } = Astro.props as { sector: string; items: Listing[] };
const name = SECTORES[sector] ?? sector;
const lugar = items[0].ubicacion;
const med = median(items.map((i) => i.precio ?? 0));
const title = `Traspasos de ${name.toLowerCase()} en ${lugar}`;
---
<Base title={title}
      description={`${items.length} ${items.length === 1 ? "negocio" : "negocios"} de ${name.toLowerCase()} en traspaso o venta en ${lugar}.${med ? ` Precio mediano ${eur(med)}.` : ""}`}
      noindex={items.length < 2}>
  <p class="muted"><a href="/">Inicio</a> › <a href={`/traspasos/${sector}/`}>{name}</a> › {lugar}</p>
  <h1>{title}</h1>
  <p class="muted">{items.length} anuncios activos{med ? <> · precio mediano {eur(med)}</> : null} ·
    <a href={`/provincia/${items[0].provincia}/`}>todos los sectores en {lugar}</a></p>
  <AdSlot />
  <div class="grid">{items.map((l) => <ListingCard l={l} />)}</div>
</Base>
