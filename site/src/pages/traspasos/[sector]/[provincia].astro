---
import Base from "../../../layouts/Base.astro";
import AdSlot from "../../../components/AdSlot.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ExplorerComponent } from "../../../components/ng/explorer.component";
import { active, eur, median, provincias, sample, SECTORES, SECTOR_ICON, toRow, type Listing } from "../../../lib/data";

// "traspasos <sector> <provincia>": las páginas que más tráfico de Google atraen.
export function getStaticPaths() {
  const groups = new Map<string, Listing[]>();
  for (const l of active) {
    if (!l.provincia) continue;
    const k = `${l.sector}|${l.provincia}`;
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k)!.push(l);
  }
  return [...groups.entries()].map(([k, items]) => {
    const [sector, provincia] = k.split("|");
    return { params: { sector, provincia }, props: { sector, provincia, items } };
  });
}
const { sector, provincia, items } = Astro.props as { sector: string; provincia: string; items: Listing[] };
const name = SECTORES[sector] ?? sector;
const lugar = items[0].ubicacion;
const med = median(items.map((i) => i.precio ?? 0));
const title = `Traspasos de ${name.toLowerCase()} en ${lugar}`;
---
<Base title={title}
      description={`${items.length} ${items.length === 1 ? "negocio" : "negocios"} de ${name.toLowerCase()} en traspaso o venta en ${lugar}.${med ? ` Precio mediano ${eur(med)}.` : ""}`}
      noindex={items.length < 2}>
  <PageHeader crumbs={[{ label: "Inicio", href: "/" }, { label: name, href: `/traspasos/${sector}/` }, { label: lugar ?? provincia }]}
              icon={SECTOR_ICON[sector]} title={title}
              subtitle={`<strong class="text-foreground">${items.length}</strong> anuncios activos${med ? ` · precio mediano <strong class="text-foreground">${eur(med)}</strong>` : ""} · <a class="text-primary underline underline-offset-4" href="/provincia/${provincia}/">todos los sectores en ${lugar}</a>`} />
  <AdSlot />
  <ExplorerComponent client:load preset={{ sector, provincia }} initial={sample(items, 24).map(toRow)} provinciaOptions={provincias} />
</Base>
