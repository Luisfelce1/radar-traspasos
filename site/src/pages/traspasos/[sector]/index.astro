---
import Base from "../../../layouts/Base.astro";
import AdSlot from "../../../components/AdSlot.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { ExplorerComponent } from "../../../components/ng/explorer.component";
import { byKey, eur, median, provincias, sample, SECTORES, SECTOR_ICON, toRow, type Listing } from "../../../lib/data";

export function getStaticPaths() {
  return [...byKey("sector").entries()].map(([sector, items]) => ({ params: { sector }, props: { sector, items } }));
}
const { sector, items } = Astro.props as { sector: string; items: Listing[] };
const name = SECTORES[sector] ?? sector;
const med = median(items.map((i) => i.precio ?? 0));
const provs = new Map<string, { name: string; n: number }>();
for (const i of items) if (i.provincia && i.ubicacion) {
  const p = provs.get(i.provincia) ?? { name: i.ubicacion, n: 0 };
  p.n++; provs.set(i.provincia, p);
}
const provList = [...provs.entries()].sort((a, b) => b[1].n - a[1].n);
---
<Base title={`Traspasos de ${name.toLowerCase()} en España`}
      description={`${items.length} negocios de ${name.toLowerCase()} en traspaso y venta en España.${med ? ` Precio mediano: ${eur(med)}.` : ""}`}>
  <PageHeader crumbs={[{ label: "Inicio", href: "/" }, { label: name }]} icon={SECTOR_ICON[sector]}
              title={`Traspasos de ${name.toLowerCase()} en España`}
              subtitle={`<strong class="text-foreground">${items.length}</strong> anuncios activos${med ? ` · precio mediano <strong class="text-foreground">${eur(med)}</strong>` : ""}`}>
    {provList.length > 0 && (
      <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
        {provList.map(([slug, p]) => (
          <li><a href={`/traspasos/${sector}/${slug}/`} class="inline-block rounded-full border border-border bg-surface px-3 py-1 text-sm transition hover:border-primary/40 hover:text-primary">{p.name} <span class="text-muted-foreground">{p.n}</span></a></li>
        ))}
      </ul>
    )}
  </PageHeader>
  <AdSlot />
  <ExplorerComponent client:load preset={{ sector }} initial={sample(items, 24).map(toRow)} provinciaOptions={provincias} />
</Base>
