---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { ExplorerComponent } from "../components/ng/explorer.component";
import { active, provincias, sample, toRow } from "../lib/data";
---
<Base title="Buscar negocios en traspaso" description="Filtra negocios en traspaso y venta por sector, provincia y precio.">
  <PageHeader crumbs={[{ label: "Inicio", href: "/" }, { label: "Buscar" }]} title="Buscar negocios"
              subtitle={`${active.length.toLocaleString("es-ES")} anuncios activos, en orden aleatorio.`} />
  <ExplorerComponent client:load syncUrl={true} initial={sample(active, 24).map(toRow)} provinciaOptions={provincias} />
</Base>
