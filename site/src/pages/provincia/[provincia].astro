---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import PageHeader from "../../components/PageHeader.astro";
import { ExplorerComponent } from "../../components/ng/explorer.component";
import { byKey, eur, median, provincias, sample, SECTORES, SECTOR_ICON, toRow, type Listing } from "../../lib/data";

export function getStaticPaths() {
  return [...byKey("provincia").entries()].map(([provincia, items]) => ({ params: { provincia }, props: { provincia, items } }));
}
const { provincia, items } = Astro.props as { provincia: string; items: Listing[] };
const lugar = items[0].ubicacion;
const med = median(items.map((i) => i.precio ?? 0));
const secs = new Map<string, number>();
for (const i of items) secs.set(i.sector, (secs.get(i.sector) ?? 0) + 1);
---
<Base title={`Negocios en traspaso en ${lugar}`}
      description={`${items.length} negocios en traspaso y venta en ${lugar}.${med ? ` Precio mediano ${eur(med)}.` : ""}`}>
  <PageHeader crumbs={[{ label: "Inicio", href: "/" }, { label: lugar ?? provincia }]} icon="📍"
              title={`Negocios en traspaso en ${lugar}`}
              subtitle={`<strong class="text-foreground">${items.length}</strong> anuncios activos${med ? ` · precio mediano <strong class="text-foreground">${eur(med)}</strong>` : ""}`}>
    <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
      {[...secs.entries()].sort((a, b) => b[1] - a[1]).map(([s, n]) => (
        <li><a href={`/traspasos/${s}/${provincia}/`} class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 text-sm transition hover:border-primary/40 hover:text-primary">{SECTOR_ICON[s]} {SECTORES[s] ?? s} <span class="text-muted-foreground">{n}</span></a></li>
      ))}
    </ul>
  </PageHeader>
  <AdSlot />
  <ExplorerComponent client:load preset={{ provincia }} initial={sample(items, 24).map(toRow)} provinciaOptions={provincias} />
</Base>
