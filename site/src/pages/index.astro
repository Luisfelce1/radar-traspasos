---
import Base from "../layouts/Base.astro";
import ListingCard from "../components/ListingCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { active, byKey, provincias, SECTORES } from "../lib/data";
import { SITE_NAME, SITE_TAGLINE } from "../lib/site";

const latest = active.slice(0, 24);
const sectores = [...byKey("sector").entries()].sort((a, b) => b[1].length - a[1].length);
---
<Base title={SITE_NAME} description={SITE_TAGLINE}>
  <h1>Negocios en traspaso y venta en España</h1>
  <p class="muted">{active.length.toLocaleString("es-ES")} anuncios activos de varios portales, actualizados varias veces al día.</p>

  <form action="/buscar/" method="get" class="search">
    <input name="q" placeholder="Busca: cafetería Valencia, peluquería, franquicia…" aria-label="Buscar" />
    <button class="btn" type="submit">Buscar</button>
  </form>

  {sectores.length > 0 && (
    <>
      <h2>Por sector</h2>
      <ul class="chips">
        {sectores.map(([s, items]) => <li><a href={`/traspasos/${s}/`}>{SECTORES[s] ?? s} ({items.length})</a></li>)}
      </ul>
    </>
  )}
  {provincias.length > 0 && (
    <>
      <h2>Por provincia</h2>
      <ul class="chips">
        {provincias.map(([slug, name]) => <li><a href={`/provincia/${slug}/`}>{name}</a></li>)}
      </ul>
    </>
  )}

  <AdSlot />

  <h2>Últimos anuncios</h2>
  {latest.length ? (
    <div class="grid">{latest.map((l) => <ListingCard l={l} />)}</div>
  ) : (
    <p class="muted">Aún no hay anuncios. El robot los añadirá en su próxima ejecución.</p>
  )}
</Base>

<style>
  .search { display: flex; gap: 8px; margin: 18px 0 8px; max-width: 640px; }
  .search .btn { border: 0; cursor: pointer; white-space: nowrap; }
</style>
