---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import { BreadcrumbsComponent } from "../../components/ng/breadcrumbs.component";
import { ListingDetailComponent } from "../../components/ng/listing-detail.component";
import { ListingCardComponent } from "../../components/ng/listing-card.component";
import { all, active, eur, priceLabel, SECTORES, SECTOR_ICON, tipoLabel, toRow, type Listing } from "../../lib/data";

export function getStaticPaths() {
  return all.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Listing };
const sector = SECTORES[l.sector] ?? "Negocio";
const retirado = l.status === "retirado";
const related = active
  .filter((x) => x.id !== l.id && x.sector === l.sector && (x.provincia === l.provincia || !l.provincia))
  .slice(0, 6);
const ubic = l.municipio && l.municipio !== l.ubicacion ? `${l.municipio} (${l.ubicacion})` : l.ubicacion;
const facts = ([
  ["Operación", tipoLabel(l.tipo)],
  ["Sector", sector],
  ["Ubicación", ubic],
  ["Precio", priceLabel(l)],
  ["Facturación", eur(l.facturacion)],
  ["Alquiler mensual", eur(l.alquiler_mensual)],
  ["Superficie", l.superficie ? `${l.superficie} m²` : null],
  ["Empleados", l.empleados],
  ["Publicado en origen", l.published],
  ["Visto por primera vez", l.first_seen],
] as [string, string | null][]).filter((f): f is [string, string] => !!f[1]);

const detail = {
  title: l.title,
  tipo: tipoLabel(l.tipo),
  sector,
  icon: SECTOR_ICON[l.sector] ?? "📦",
  price: priceLabel(l),
  priceMuted: !l.precio,
  summary: l.summary,
  url: l.url,
  sourceName: l.source_name,
  alsoOn: (l.also_on ?? []).map((u, i) => ({ url: u, name: l.also_on_names?.[i] ?? "otro portal" })),
  facts,
  retired: retirado,
  retiredOn: l.retired_on,
};
const crumbs = [
  { label: "Inicio", href: "/" },
  { label: sector, href: `/traspasos/${l.sector}/` },
  ...(l.provincia ? [{ label: l.ubicacion ?? "", href: `/traspasos/${l.sector}/${l.provincia}/` }] : []),
  { label: l.title.length > 40 ? l.title.slice(0, 40) + "…" : l.title },
];
const desc = `${tipoLabel(l.tipo)} de ${sector.toLowerCase()}${l.ubicacion ? ` en ${l.ubicacion}` : ""}. ${priceLabel(l)}. ${l.summary}`.slice(0, 158);
---
<Base title={l.title} description={desc} noindex={retirado}>
  <div class="mb-6"><BreadcrumbsComponent items={crumbs} /></div>
  <ListingDetailComponent d={detail} />
  <AdSlot />
  {related.length > 0 && (
    <section class="mt-14" aria-labelledby="h-rel">
      <h2 id="h-rel" class="mb-4 text-lg font-semibold tracking-tight">Otros negocios de {sector.toLowerCase()}{l.ubicacion ? ` en ${l.ubicacion}` : ""}</h2>
      <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((x) => <li><ListingCardComponent row={toRow(x)} /></li>)}
      </ul>
    </section>
  )}
</Base>
