---
import type { Listing } from "../lib/data";
import { SECTORES, priceLabel, tipoLabel } from "../lib/data";
interface Props { l: Listing }
const { l } = Astro.props;
---
<article class="card">
  <div class="meta">
    <span class="tag">{tipoLabel(l.tipo)}</span>
    <span>{SECTORES[l.sector] ?? "Negocio"}</span>
    {l.ubicacion && <span>· {l.ubicacion}</span>}
  </div>
  <h3><a href={`/anuncio/${l.slug}/`}>{l.title}</a></h3>
  <p class="price">{priceLabel(l)}</p>
  <p class="sum">{l.summary}</p>
  <p class="src">Vía {l.source_name}{l.also_on_names?.length ? ` y ${l.also_on_names.length} más` : ""}</p>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: flex; flex-direction: column; }
  .meta { font-size: .8rem; color: var(--muted); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .tag { background: var(--accent-soft); color: var(--accent); padding: 1px 8px; border-radius: 999px; font-weight: 600; }
  h3 { font-size: 1.02rem; line-height: 1.3; margin: 8px 0 4px; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .price { font-weight: 700; margin: 2px 0 6px; }
  .sum { color: var(--muted); font-size: .92rem; margin: 0 0 8px; flex: 1; }
  .src { font-size: .78rem; color: var(--muted); margin: 0; }
</style>
