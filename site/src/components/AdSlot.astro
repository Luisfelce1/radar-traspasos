---
// Hueco de anuncio. Solo se pinta si PUBLIC_ADSENSE_CLIENT y el slot están configurados.
import { ADSENSE_CLIENT } from "../lib/site";
interface Props { slot?: string }
const slot = Astro.props.slot || import.meta.env.PUBLIC_ADSENSE_SLOT || "";
---
{ADSENSE_CLIENT && slot && (
  <div class="ad">
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={slot}
         data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
<style>.ad { margin: 24px 0; min-height: 90px; }</style>
